rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      // Users can read their own profile
      allow get: if isValidId(userId) && isOwner(userId);
      // No blanket listing of user records
      allow list: if false;

      // Users can update their profile, but cannot modify their immutable identity fields (uid, email)
      allow update: if isValidId(userId) && isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      // Document creation is handled by the server session endpoint
      allow create, delete: if false;

      // Personalized assessment sections subcollection
      match /assessmentSections/{sectionId} {
        // Users can read and list their own assessment sections
        allow get, list: if isValidId(userId) && isValidId(sectionId) && isOwner(userId);
        // Scores, status transitions, question IDs and attempts are strictly server-controlled
        allow write: if false;
      }
    }

    // Question banks, answer keys, and test cases are strictly server-only
    match /questionBank/{bankId} {
      allow read, write: if false;
    }
  }
}
